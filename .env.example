# Copy to .env.local and fill in. Never commit real values.
# Every integration is optional: the app runs (in mock AI mode) with only the
# "App" section filled in.

# --- App ---------------------------------------------------------------
APP_URL=http://localhost:3000
APP_PASSWORD=
# 32+ random characters, e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`
SESSION_SECRET=
# Used to keep you out of the recipient list and to sign emails.
MY_NAME=
MY_EMAIL=
# Local SQLite by default; use a Turso/libSQL URL + token in production.
DATABASE_URL=file:./data/echo.db
DATABASE_AUTH_TOKEN=

# --- Claude API ----------------------------------------------------------
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5
# Force placeholder AI output even when a key is set (1 = on).
ECHO_MOCK_AI=

# --- Zoom (Server-to-Server OAuth app) ----------------------------------
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_WEBHOOK_SECRET_TOKEN=

# --- Daily reconciliation (GET /api/cron/reconcile, Bearer token) ----------
CRON_SECRET=

# --- Google Calendar (attendee emails; calendar.readonly scope) ------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary

# --- Notion (optional mirror of drafts) -----------------------------------
NOTION_TOKEN=
NOTION_DATABASE_ID=
# A page shared with the integration; Settings can create the database under it.
NOTION_PARENT_PAGE_ID=
